        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOTM\DefaultIcon" Value="[#WordsDOTMIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOTM\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Words.DOTM" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".dotm" Value="Words.DOTM" Type="string"/>
