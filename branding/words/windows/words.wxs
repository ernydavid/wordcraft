        <RegistryValue Root="HKLM" Key="Software\Classes\Words.ODT" Name="FriendlyTypeName" Value="Words ODT document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.ODT\DefaultIcon" Value="[#WordsODTIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.ODT\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Words.ODT" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".odt" Value="Words.ODT" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".odt" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentTXT" Guid="*">
        <File Id="WordsTXTIcon" Source="$(var.DocumentIconDir)\words-txt.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.TXT" Name="FriendlyTypeName" Value="Words TXT document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.TXT\DefaultIcon" Value="[#WordsTXTIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.TXT\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Words.TXT" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".txt" Value="Words.TXT" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".txt" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentMD" Guid="*">
        <File Id="WordsMDIcon" Source="$(var.DocumentIconDir)\words-md.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.MD" Name="FriendlyTypeName" Value="Words MD document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.MD\DefaultIcon" Value="[#WordsMDIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.MD\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Words.MD" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".md" Value="Words.MD" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".md" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentHTML" Guid="*">
        <File Id="WordsHTMLIcon" Source="$(var.DocumentIconDir)\words-html.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTML" Name="FriendlyTypeName" Value="Words HTML document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTML\DefaultIcon" Value="[#WordsHTMLIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTML\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.html\OpenWithProgids" Name="Words.HTML" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".html" Value="Words.HTML" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".html" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentHTM" Guid="*">
        <File Id="WordsHTMIcon" Source="$(var.DocumentIconDir)\words-htm.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTM" Name="FriendlyTypeName" Value="Words HTM document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTM\DefaultIcon" Value="[#WordsHTMIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.HTM\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.htm\OpenWithProgids" Name="Words.HTM" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".htm" Value="Words.HTM" Type="string"/>
