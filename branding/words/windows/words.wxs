        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Words.RTF" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".rtf" Value="Words.RTF" Type="string"/>
