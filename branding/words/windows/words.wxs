        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOT\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Words.DOT" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".dot" Value="Words.DOT" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".dot" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentRTF" Guid="*">
