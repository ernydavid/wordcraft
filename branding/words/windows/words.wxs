        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Words.DOTX" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".dotx" Value="Words.DOTX" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".dotx" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentDOTM" Guid="*">
