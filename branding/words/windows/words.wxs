<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Own MSI identity: never reuse WordCraft's UpgradeCode or component GUIDs. -->
  <Package Name="Words" Manufacturer="Words Project" Version="$(var.Version)"
           UpgradeCode="A888DE9F-0C63-437E-9E39-A00E4A0140CA" Language="1033"
           Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Words document editor" Manufacturer="Words Project"/>
    <MajorUpgrade DowngradeErrorMessage="A newer Words version is installed."/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="WordsIcon" SourceFile="$(var.IconPath)"/>
    <Property Id="ARPPRODUCTICON" Value="WordsIcon"/>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Words"/>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <Feature Id="Main" Title="Words" Level="1"><ComponentGroupRef Id="WordsFiles"/></Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="WordsFiles" Directory="INSTALLFOLDER">
      <Component Id="WordsApp" Guid="073E3BBA-C2E3-44F8-8660-E288B4D1E877">
        <File Id="WordsExe" Source="$(var.BinDir)\Words.exe" KeyPath="yes">
          <Shortcut Id="WordsShortcut" Directory="ProgramMenuFolder" Name="Words"
                    Description="Words document editor" WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" Icon="WordsIcon" IconIndex="0"/>
        </File>
        <File Source="$(var.BinDir)\LICENSE-MIT"/>
        <File Source="$(var.BinDir)\LICENSE-APACHE"/>
        <File Source="$(var.BinDir)\NOTICE"/>
        <File Source="$(var.BinDir)\ATTRIBUTION.md"/>
      </Component>
      <Component Id="WordsDocumentDOCX" Guid="*">
        <File Id="WordsDOCXIcon" Source="$(var.DocumentIconDir)\words-docx.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCX" Name="FriendlyTypeName" Value="Words DOCX document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCX\DefaultIcon" Value="[#WordsDOCXIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCX\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Words.DOCX" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".docx" Value="Words.DOCX" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".docx" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentDOC" Guid="*">
        <File Id="WordsDOCIcon" Source="$(var.DocumentIconDir)\words-doc.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOC" Name="FriendlyTypeName" Value="Words DOC document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOC\DefaultIcon" Value="[#WordsDOCIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOC\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Words.DOC" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".doc" Value="Words.DOC" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".doc" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentDOCM" Guid="*">
        <File Id="WordsDOCMIcon" Source="$(var.DocumentIconDir)\words-docm.ico" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCM" Name="FriendlyTypeName" Value="Words DOCM document" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCM\DefaultIcon" Value="[#WordsDOCMIcon]" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Words.DOCM\shell\open\command" Value="&quot;[#WordsExe]&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Words.DOCM" Value="" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Words\Capabilities\FileAssociations" Name=".docm" Value="Words.DOCM" Type="string"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Words.exe\SupportedTypes" Name=".docm" Value="" Type="string"/>
      </Component>
      <Component Id="WordsDocumentDOTX" Guid="*">
